<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>safety_filter</name>
  <version>1.0.0</version>
  <description>
    Attack-aware robust control barrier function (RCBF) safety filter.
    Public implementation of the Proposed three-tier filter
    (STRICT -> SOFT -> MIN_RISK) for post-filter actuator-command injection attacks.
  </description>
  <maintainer email="franck.cheng@example.com">Franck Cheng</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
