<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>attack_safe_tb3_sim</name>
  <version>1.0.0</version>
  <description>
    Gazebo simulation assets and launch files for the attack-aware RCBF demo
    (TurtleBot3 Burger, Nav2/MPPI nominal controller, Proposed safety filter).
  </description>
  <maintainer email="franck.cheng@example.com">Franck Cheng</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>dwb_core</exec_depend>

  <exec_depend>safety_filter</exec_depend>
  <exec_depend>actuator_attack</exec_depend>
  <exec_depend>scan_range_limiter</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
