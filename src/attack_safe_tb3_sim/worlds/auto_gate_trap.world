<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <scene><shadows>false</shadows></scene>
    <physics type="ode">
      <real_time_update_rate>100.0</real_time_update_rate>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode><solver><type>quick</type><iters>150</iters><precon_iters>0</precon_iters><sor>1.4</sor><use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling></solver>
      <constraints><cfm>0.00001</cfm><erp>0.2</erp><contact_max_correcting_vel>2000.0</contact_max_correcting_vel><contact_surface_layer>0.01</contact_surface_layer></constraints></ode>
    </physics>

    <!-- Walls -->
    <model name="wall_l"><static>1</static><pose>0 2.5 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>16 0.2 0.3</size></box></geometry></collision><visual name="v"><geometry><box><size>16 0.2 0.3</size></box></geometry></visual></link></model>
    <model name="wall_r"><static>1</static><pose>0 -2.5 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>16 0.2 0.3</size></box></geometry></collision><visual name="v"><geometry><box><size>16 0.2 0.3</size></box></geometry></visual></link></model>
    <model name="end_wall"><static>1</static><pose>8.5 0 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 5 0.3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 5 0.3</size></box></geometry></visual></link></model>

    <!-- Gate pillars -->
    <model name="gate_L"><static>1</static><pose>2.0 0.65 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.22</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.22</radius><length>0.3</length></cylinder></geometry><material><ambient>1 0.4 0.0 1</ambient></material></visual></link></model>
    <model name="gate_R"><static>1</static><pose>2.0 -0.65 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.22</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.22</radius><length>0.3</length></cylinder></geometry><material><ambient>1 0.4 0.0 1</ambient></material></visual></link></model>

    <!-- Post-gate trap -->
    <model name="trap"><static>1</static><pose>2.7 0.15 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry><material><ambient>1 0.2 0.0 1</ambient></material></visual></link></model>

    <!-- Side squeeze obstacles -->
    <model name="sq_L1"><static>1</static><pose>5.0 0.55 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.30</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.30</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="sq_L2"><static>1</static><pose>5.8 0.55 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.28</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.28</radius><length>0.3</length></cylinder></geometry></visual></link></model>

    <!-- Background obstacles -->
        <model name="bg_0"><static>1</static><pose>0.8 1.2 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="bg_1"><static>1</static><pose>1.8 -1.8 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="bg_2"><static>1</static><pose>1.8 1.6 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.28</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.28</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="bg_3"><static>1</static><pose>3.5 -1.2 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="bg_4"><static>1</static><pose>4.0 1.0 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="bg_5"><static>1</static><pose>4.5 -1.0 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="bg_6"><static>1</static><pose>5.0 -0.6 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.22</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.22</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="bg_7"><static>1</static><pose>5.8 -0.5 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="bg_8"><static>1</static><pose>6.5 -1.5 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="bg_9"><static>1</static><pose>7.0 1.0 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="bg_10"><static>1</static><pose>7.5 -0.8 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.22</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.22</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="sq_0"><static>1</static><pose>5.0 0.55 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></visual></link></model>
    <model name="sq_1"><static>1</static><pose>5.8 0.55 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.28</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.28</radius><length>0.3</length></cylinder></geometry></visual></link></model>

  </world>
</sdf>
